# Example environment file. Copy to `.env` and fill in real values:
#
#     cp .env.example .env
#
# `.env` is gitignored and must stay that way — every value below is either a secret
# or machine-specific. Names here are the names `propertyfinder/config.py` reads
# (Settings is case-insensitive: SEARCHAPI_API_KEY and searchapi_api_key are the same
# field). Anything left unset falls back to the default shown in the comment.

# --- the search provider (required before any sweep) ------------------------------
# A trial key is enough for the early milestones; a paid-plan key is needed once the
# monthly sweep volume grows. Without this, `sweep` refuses rather than silently
# collecting nothing.
SEARCHAPI_API_KEY=

# Monthly API-call ceiling, enforced in-process so a runaway sweep cannot spend real
# money. `daily` spends at most this divided across 30 days. Default: 1000.
QUOTA_CAP_SEARCHAPI_MONTHLY=1000

# --- storage ----------------------------------------------------------------------
# Where the SQLite database lives. Default: propertyfinder.db in the repo root.
# PROPERTYWATCH_DB_PATH is also accepted, so an .env from the original tool keeps working.
PROPERTYFINDER_DB_PATH=propertyfinder.db

# --- mail, for the daily digest (optional) ----------------------------------------
# All five of SMTP_HOST / SMTP_USERNAME / SMTP_PASSWORD / ALERT_EMAIL_FROM /
# ALERT_EMAIL_TO are needed to send. Leave them unset and `daily` prints the digest
# to its own output instead of mailing it — useful while testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# --- publishing the reports site (optional; see docs/vercel.md) -------------------
# Basic Auth at the Vercel edge, in front of every `private` path in site-manifest.yaml.
# The middleware fails closed: with SITE_PASSWORD unset, private paths 401 for everyone.
# These belong in the Vercel project's environment variables, not only here.
SITE_USER=admin
SITE_PASSWORD=

# Headless deploys (`propertyfinder daily --deploy`, scripts/deploy.sh).
# Token from https://vercel.com/account/tokens.
VERCEL_TOKEN=

# The production alias, so scripts/deploy.sh can verify the deploy from outside.
# Without it the deploy still happens but reports NOT VERIFIED.
SITE_BASE_URL=
